{% import "components/icon_macro.html.twig" as icon %}

<form method="post" action="{{ action_url }}" class="p-6 rounded-xl border border-line bg-surface-2 space-y-5"
	hx-post="{{ action_url }}"
	hx-target="#main-content"
	hx-swap="innerHTML">
	<input type="hidden" name="_csrf" value="{{ csrf_token }}">

	<!-- Name Field -->
	<div>
		<label for="name" class="block text-sm font-medium text-fg mb-1.5">{{ t('backoffice.users.form_name') }}</label>
		<input type="text" id="name" name="name" value="{{ user_data.name ?? '' }}" required
			class="w-full px-3 py-2 text-sm rounded-lg border bg-surface text-fg focus:outline-none transition-all
			{% if errors.name is defined %}border-danger-text focus:ring-2 focus:ring-danger-text/20{% else %}border-line focus:border-accent focus:ring-2 focus:ring-accent/20{% endif %}"
			placeholder="{{ t('backoffice.users.placeholder_name') }}">
		{% if errors.name is defined %}
			<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
				{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
				{{ t(errors.name) }}
			</p>
		{% endif %}
	</div>

	<!-- Email Field -->
	<div>
		<label for="email" class="block text-sm font-medium text-fg mb-1.5">{{ t('backoffice.users.form_email') }}</label>
		<input type="email" id="email" name="email" value="{{ user_data.email ?? '' }}" required
			class="w-full px-3 py-2 text-sm rounded-lg border bg-surface text-fg focus:outline-none transition-all
			{% if errors.email is defined %}border-danger-text focus:ring-2 focus:ring-danger-text/20{% else %}border-line focus:border-accent focus:ring-2 focus:ring-accent/20{% endif %}"
			placeholder="name@example.com">
		{% if errors.email is defined %}
			<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
				{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
				{{ t(errors.email) }}
			</p>
		{% endif %}
	</div>

	<!-- Password & Confirm Password (Grid 2 คอลัมน์) -->
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
		<div>
			<label for="password" class="block text-sm font-medium text-fg mb-1.5">
				{{ t('backoffice.users.form_password') }}
				{% if is_edit %}
					<span class="text-xs font-normal text-fg-secondary">({{ t('backoffice.users.leave_blank_to_keep')|default('Leave blank to keep current') }})</span>
				{% endif %}
			</label>
			<input type="password" id="password" name="password" {% if not is_edit %}required{% endif %}
				class="w-full px-3 py-2 text-sm rounded-lg border bg-surface text-fg focus:outline-none transition-all
				{% if errors.password is defined %}border-danger-text focus:ring-2 focus:ring-danger-text/20{% else %}border-line focus:border-accent focus:ring-2 focus:ring-accent/20{% endif %}">
			{% if errors.password is defined %}
				<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
					{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
					{{ t(errors.password) }}
				</p>
			{% endif %}
		</div>
		<div>
			<label for="confirm_password" class="block text-sm font-medium text-fg mb-1.5">{{ t('backoffice.users.form_confirm_password') }}</label>
			<input type="password" id="confirm_password" name="confirm_password" {% if not is_edit %}required{% endif %}
				class="w-full px-3 py-2 text-sm rounded-lg border bg-surface text-fg focus:outline-none transition-all
				{% if errors.confirm_password is defined %}border-danger-text focus:ring-2 focus:ring-danger-text/20{% else %}border-line focus:border-accent focus:ring-2 focus:ring-accent/20{% endif %}">
			{% if errors.confirm_password is defined %}
				<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
					{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
					{{ t(errors.confirm_password) }}
				</p>
			{% endif %}
		</div>
	</div>

	<!-- Role Field -->
	<div>
		<label for="role" class="block text-sm font-medium text-fg mb-1.5">{{ t('backoffice.users.form_role') }}</label>
		<select id="role" name="role" class="w-full px-3 py-2 text-sm rounded-lg border bg-surface text-fg focus:outline-none transition-all
			{% if errors.role is defined %}border-danger-text focus:ring-2 focus:ring-danger-text/20{% else %}border-line focus:border-accent focus:ring-2 focus:ring-accent/20{% endif %}">
			<option value="">{{ t('backoffice.users.no_role') }}</option>
			{% for role in roles %}
				<option value="{{ role.name }}" {% if (user_data.role ?? '') == role.name %}selected{% endif %}>{{ role.name }}</option>
			{% endfor %}
		</select>
		{% if errors.role is defined %}
			<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
				{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
				{{ t(errors.role) }}
			</p>
		{% endif %}
	</div>

	<!-- Active Status (Radio Options) -->
	<div>
		<label class="block text-sm font-medium text-fg mb-2">{{ t('backoffice.users.col_status') }}</label>
		<div class="flex items-center gap-6">
			{% set is_active_val = user_data.is_active ?? true %}
			<label class="inline-flex items-center gap-2 cursor-pointer text-sm text-fg">
				<input type="radio" name="is_active" value="1"
					{% if is_active_val == '1' or is_active_val == true %}checked{% endif %}
					class="w-4 h-4 text-accent border-line focus:ring-accent bg-surface">
				<span>{{ t('backoffice.users.status_active') }}</span>
			</label>
			<label class="inline-flex items-center gap-2 cursor-pointer text-sm text-fg">
				<input type="radio" name="is_active" value="0"
					{% if is_active_val == '0' or is_active_val == false %}checked{% endif %}
					class="w-4 h-4 text-accent border-line focus:ring-accent bg-surface">
				<span>{{ t('backoffice.users.status_inactive') }}</span>
			</label>
		</div>
		{% if errors.is_active is defined %}
			<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
				{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
				{{ t(errors.is_active) }}
			</p>
		{% endif %}
	</div>

	<!-- Form Actions -->
	<div class="flex items-center justify-end gap-3 pt-4 border-t border-line">
		<button type="button" class="px-4 py-2 text-sm font-medium border border-line rounded-lg text-fg-secondary hover:bg-surface-1 transition-colors"
			hx-get="{{ url('/backoffice/users') }}"
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="true">
			{{ t('backoffice.common.cancel') }}
		</button>
		<button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-accent text-accent-fg hover:opacity-90 transition-opacity">
			{{ t('backoffice.common.save') }}
		</button>
	</div>
</form>
