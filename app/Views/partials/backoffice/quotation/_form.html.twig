{% import "components/icon_macro.html.twig" as icon %}

<form method="post" action="{{ action_url }}" class="p-6 rounded-xl border border-line bg-surface-2 space-y-6"
	hx-post="{{ action_url }}"
	hx-target="#main-content">
	<input type="hidden" name="_csrf" value="{{ csrf_token }}">
	
	<div>
		<div class="grid grid-cols-1 gap-6">
			<div>
				<label class="block text-sm font-medium text-fg mb-1.5">Title</label>
				<input type="text" name="title" value="{{ quotation.title ?? '' }}" placeholder="Quotation title"
					class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
			</div>
		</div>
	</div>

	<div>
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
			<div>
				<div class="flex items-center justify-between mb-1.5">
					<label class="block text-sm font-medium text-fg">Customer</label>
					{% if not is_edit %}
						<label class="flex items-center gap-1.5 cursor-pointer">
							<input type="checkbox" name="is_new_customer" value="1" class="w-4 h-4 rounded border border-line text-accent focus:ring-accent/20 cursor-pointer">
							<span class="text-xs font-medium text-fg-secondary">New Customer</span>
						</label>
					{% endif %}
				</div>
				
				<div id="existing_customer_container">
					<select name="customer_id" required 
						class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all disabled:opacity-50 disabled:bg-surface-1 disabled:cursor-not-allowed">
						<option value="">Select a customer</option>
						{% for c in customers %}
							<option value="{{ c.id }}" {% if (quotation.customer_id ?? '') == c.id %}selected{% endif %}>{{ c.name }}</option>
						{% endfor %}
					</select>
				</div>
			</div>

			<div>
				<label class="block text-sm font-medium text-fg mb-1.5">Issue Date</label>
				<input type="text" name="issue_date" required value="{{ quotation.issue_date ?? 'now'|date('Y-m-d') }}" 
					class="js-datepicker w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
			</div>
		</div>

		<div id="new_customer_wrapper" class="grid grid-rows-[0fr] transition-all duration-300 ease-in-out opacity-0 mt-0">
			<div class="overflow-hidden min-h-0">
				<div id="new_customer_container" class="space-y-3">
					<div class="flex items-center justify-between mb-1.5">
						<label class="block text-sm font-medium text-fg">New Customer Details</label>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<input type="text" name="new_customer_name" placeholder="Customer Name *" 
							class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
						
						<div class="grid grid-cols-2 gap-3">
							<input type="text" name="new_customer_tax_id" placeholder="Tax ID" 
								class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
							<input type="text" name="new_customer_phone" placeholder="Phone" 
								class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
						</div>
					</div>
					
					<textarea name="new_customer_address" placeholder="Address" rows="2"
						class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all resize-none"></textarea>
				</div>
			</div>
		</div>
	</div>
	
	<div class="pt-6 border-t border-line">
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-base font-medium text-fg">Items</h3>
			<button type="button" data-action="quotation-add" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg bg-surface-1 border border-line text-fg hover:bg-surface transition-colors cursor-pointer">
				{{ icon.use('plus') }}
				Add Item
			</button>
		</div>
		
		<div class="space-y-3" data-quotation-items>
			{% if quotation is defined and items is defined and items|length > 0 %}
				{% for item in items %}
					<div data-quotation-row class="flex gap-3 items-center group bg-surface-2 p-2 rounded-lg border border-transparent">
						<div class="flex flex-col items-center justify-center min-w-[24px]">
							<span data-quotation-item-seq class="text-[10px] leading-none">{{ loop.index }}</span>
							<div data-quotation-drag class="cursor-grab active:cursor-grabbing text-fg-muted hover:text-fg px-1">
								{{ icon.use('menu') }}
							</div>
						</div>
						<div class="flex-1">
							<input type="text" name="item_name[]" placeholder="Item Name" value="{{ item.name }}" required 
								class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
						</div>
						<div class="w-16 sm:w-24">
							<input type="number" step="1" name="item_quantity[]" placeholder="Qty" value="{{ item.quantity }}" required 
								class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
						</div>
						<div class="w-32 sm:w-40">
							<input type="number" step="0.01" name="item_price[]" placeholder="Price" value="{{ item.unit_price }}" required 
								class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
						</div>
						<div class="w-32 sm:w-40">
							<input type="number" step="0.01" name="labor_price[]" placeholder="Labor Price" value="{{ item.labor_price }}" required 
								class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
						</div>
						<button type="button" data-action="quotation-remove" class="p-2 text-fg-muted hover:text-danger-text hover:bg-danger-bg rounded-lg transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100">
							{{ icon.use('delete') }}
						</button>
					</div>
				{% endfor %}
			{% else %}
				<div data-quotation-row class="flex gap-3 items-center group bg-surface-2 p-2 rounded-lg border border-transparent">
					<div class="flex flex-col items-center justify-center min-w-[24px]">
						<span data-quotation-item-seq class="text-[10px] leading-none">1.</span>
						<div data-quotation-drag class="cursor-grab active:cursor-grabbing text-fg-muted hover:text-fg px-1">
							{{ icon.use('menu') }}
						</div>
					</div>
					<div class="flex-1">
						<input type="text" name="item_name[]" placeholder="Item Name" required 
							class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
					</div>
					<div class="w-16 sm:w-24">
						<input type="number" step="1" name="item_quantity[]" placeholder="Qty" value="1" required 
							class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
					</div>
					<div class="w-32 sm:w-40">
						<input type="number" step="0.01" name="item_price[]" placeholder="Price" required 
							class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
					</div>
					<div class="w-32 sm:w-40">
						<input type="number" step="0.01" name="labor_price[]" placeholder="Labor Price" required 
							class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
					</div>
					<button type="button" data-action="quotation-remove" class="p-2 text-fg-muted hover:text-danger-text hover:bg-danger-bg rounded-lg transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100">
						{{ icon.use('delete') }}
					</button>
				</div>
			{% endif %}
		</div>
		
		<template data-quotation-template>
			<div data-quotation-row class="flex gap-3 items-center group bg-surface-2 p-2 rounded-lg border border-transparent">
				<div class="flex flex-col items-center justify-center min-w-[24px]">
					<span data-quotation-item-seq class="text-[10px] leading-none"></span>
					<div data-quotation-drag class="cursor-grab active:cursor-grabbing text-fg-muted hover:text-fg px-1">
						{{ icon.use('menu') }}
					</div>
				</div>
				<div class="flex-1">
					<input type="text" name="item_name[]" placeholder="Item Name" required 
						class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
				</div>
				<div class="w-16 sm:w-24">
					<input type="number" step="0.01" name="item_quantity[]" placeholder="Qty" value="1" required 
						class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
				</div>
				<div class="w-32 sm:w-40">
					<input type="number" step="0.01" name="item_price[]" placeholder="Price" required 
						class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
				</div>
				<div class="w-32 sm:w-40">
					<input type="number" step="0.01" name="labor_price[]" placeholder="Labor Price" required 
						class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
				</div>
				<button type="button" data-action="quotation-remove" class="p-2 text-fg-muted hover:text-danger-text hover:bg-danger-bg rounded-lg transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100">
					{{ icon.use('delete') }}
				</button>
			</div>
		</template>
	</div>
	
	<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 pt-6 border-t border-line">
		<div>
			<label class="block text-sm font-medium text-fg mb-1.5">Discount (Amount)</label>
			<input type="number" step="0.01" name="discount" value="{{ quotation.discount ?? '0' }}" 
				class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
		</div>

		<div>
			<label class="block text-sm font-medium text-fg mb-1.5">VAT (%)</label>
			<input type="number" step="0.01" name="vat_rate" value="{{ quotation.vat_rate ?? '7' }}" 
				class="w-full px-3 py-2 text-sm rounded-lg border border-line bg-surface text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
		</div>
	</div>

	<!-- Form Actions -->
	<div class="flex items-center justify-end gap-3 pt-6 border-t border-line">
		<button type="button" class="px-4 py-2 text-sm font-medium border border-line rounded-lg text-fg-secondary hover:bg-surface-1 transition-colors"
			hx-get="{{ url('/backoffice/quotation') }}"
			hx-target="#main-content"
			hx-push-url="true">
			Cancel
		</button>
		<button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-accent text-accent-fg hover:opacity-90 transition-opacity">
			Save
		</button>
	</div>
</form>