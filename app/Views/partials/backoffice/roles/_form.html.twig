{% import "components/icon_macro.html.twig" as icon %}

<form method="post" action="{{ action_url }}" class="p-6 rounded-xl border border-line bg-surface-2 space-y-5"
	hx-post="{{ action_url }}"
	hx-target="#main-content"
	hx-swap="innerHTML">
	<input type="hidden" name="_csrf" value="{{ csrf_token }}">

	<!-- Name Field -->
	<div>
		<label for="name" class="block text-sm font-medium text-fg mb-1.5">{{ t('backoffice.roles.form_name') }}</label>
		<input type="text" id="name" name="name" value="{{ form_data.name ?? '' }}" required
			class="w-full px-3 py-2 text-sm rounded-lg border bg-surface text-fg focus:outline-none transition-all
			{% if errors.name is defined %}border-danger-text focus:ring-2 focus:ring-danger-text/20{% else %}border-line focus:border-accent focus:ring-2 focus:ring-accent/20{% endif %}"
			placeholder="{{ t('backoffice.roles.placeholder_name') }}">
		{% if errors.name is defined %}
			<p class="mt-1 text-xs text-danger-text flex items-center gap-1">
				{{ icon.use('error', 'w-3.5 h-3.5 shrink-0') }}
				{{ t(errors.name) }}
			</p>
		{% endif %}
	</div>
	
	<!-- Permissions Field -->
	{% set group = {
		users: t('backoffice.roles.users_perm'),
		roles: t('backoffice.roles.roles_perm')
	} %}
	<div class="space-y-2">
		<label class="block text-sm font-medium text-fg">{{ t('backoffice.roles.form_permissions') }}</label>
		<div class="space-y-4">
			{% for category, perms in permissions %}
				<div>
					<h4 class="text-sm font-semibold text-fg-muted mb-2">{{ group[category] }}</h4>
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 p-4 border border-line rounded-lg bg-surface-1/30">
						{% for perm in perms %}
							<label class="flex items-center gap-1 cursor-pointer group">
								<div class="relative flex items-center">
									<input type="checkbox" name="permissions[]" value="{{ perm.id }}" class="peer w-5 h-5 rounded border border-line text-accent bg-surface-1 focus:ring-accent/20 focus:ring-offset-surface focus:ring-offset-2 transition-all cursor-pointer"
										{% if perm.id in form_data.permissions|default([]) %}checked{% endif %}>
								</div>
								<span class="text-sm text-fg-secondary group-hover:text-fg transition-colors">{{ perm.name }}</span>
							</label>
						{% endfor %}
					</div>
				</div>
        {% else %}
					<p class="text-sm text-fg-muted col-span-2">No permissions available in the system.</p>
        {% endfor %}
    </div>
	</div>

	<!-- Form Actions -->
	<div class="flex items-center justify-end gap-3 pt-4 border-t border-line">
		<button type="button" class="px-4 py-2 text-sm font-medium border border-line rounded-lg text-fg-secondary hover:bg-surface-1 transition-colors"
			hx-get="{{ url('/backoffice/roles') }}"
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="true">
			{{ t('backoffice.common.cancel') }}
		</button>
		<button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-accent text-accent-fg hover:opacity-90 transition-opacity">
			{{ t('backoffice.common.save') }}
		</button>
	</div>
</form>