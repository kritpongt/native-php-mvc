{% import "components/icon_macro.html.twig" as icon %}

{% block main %}
	{% set noti_type = success ? 'success' : (error ? 'error' : null) %}
	{% set noti_message = success ?: error %}

	{% if noti_type %}
		{% include 'components/noti.html.twig' with {
				message: noti_message,
				type: noti_type,
		} %}
	{% endif %}

	<div class="space-y-6">
		<!-- Page Title & Actions -->
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
			<div>
				<h1 class="text-xl font-semibold text-fg">{{ t('backoffice.roles.title') }}</h1>
				<p class="text-sm text-fg-secondary">{{ t('backoffice.roles.subtitle') }}</p>
			</div>
			<a href="{{ url('/backoffice/roles/create') }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-accent text-accent-fg hover:opacity-90 transition-opacity"
				hx-get="{{ url('/backoffice/roles/create') }}"
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true">
				{{ icon.use('plus') }}
				{{ t('backoffice.roles.add_new') }}
			</a>
		</div>

		{# Filter & Search Bar #}
		{% include "components/search_filter.html.twig" with {
			action_url: url('/backoffice/roles'),
			search: '',
		} %}

		{# Data Table #}
		{% embed "components/data_table.html.twig" with { items: roles } %}
			{% import "components/icon_macro.html.twig" as icon %}

			{% block headers %}
				<th class="px-4 py-3">{{ t('backoffice.roles.col_id') }}</th>
				<th class="px-4 py-3">{{ t('backoffice.roles.col_role') }}</th>
				<th class="px-4 py-3 text-right">{{ t('backoffice.roles.col_actions') }}</th>
			{% endblock %}

			{% block rows %}
				{% for item in items %}
					<tr class="hover:bg-surface-1/50 transition-colors">
						<td class="px-4 py-3 text-sm font-medium text-fg-secondary">
							{{ item.id }}
						</td>
						<td class="px-4 py-3 font-medium text-fg">
							{{ item.name }}
						</td>
						<td class="px-4 py-3 text-right">
							<div class="flex items-center justify-end gap-1">
								<a href="{{ url('/backoffice/roles/' ~ item.id ~ '/edit') }}" 
									class="p-1.5 text-fg-secondary hover:text-fg hover:bg-surface-1 rounded-lg transition-colors" title="Edit"
									hx-get="{{ url('/backoffice/roles/' ~ item.id ~ '/edit') }}"
									hx-target="#main-content"
									hx-push-url="true">
									{{ icon.use('edit') }}
								</a>
								<form method="post" action="{{ url('/backoffice/roles/' ~ item.id ~ '/delete') }}" class="m-0 inline"
									hx-post="{{ url('/backoffice/roles/' ~ item.id ~ '/delete') }}"
									hx-target="#main-content"
									data-dialog-confirm="Are you sure you want to delete this role?">
									<input type="hidden" name="_csrf" value="{{ csrf_token }}">
									<button type="submit" class="p-1.5 text-danger-text hover:bg-surface-1 rounded-lg transition-colors" title="Delete">
										{{ icon.use('delete') }}
									</button>
								</form>
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="3" class="px-4 py-8 text-center text-xs text-fg-muted">
							{{ t('backoffice.roles.empty') }}
						</td>
					</tr>
				{% endfor %}
			{% endblock %}
		{% endembed %}
	</div>
{% endblock %}
