{% extends 'layouts/base.html.twig' %}

{# pages override this to light their own sidebar item #}
{% block nav_active %}dashboard{% endblock %}

{% block content %}
{% set active = block('nav_active') %}
{% set nav = [
	{ key: 'dashboard', label: t('backoffice.nav.dashboard'), href: url('/backoffice') },
	{ key: 'users', label: t('backoffice.nav.users'), href: url('/backoffice/users') },
	{ key: 'rbac', label: t('backoffice.nav.rbac'), href: url('/backoffice/roles') },
	{ key: 'audit', label: t('backoffice.nav.audit'), href: url('/backoffice/audit') },
	{ key: 'settings', label: t('backoffice.nav.settings'), href: url('/backoffice/settings') },
] %}
{# raw: static system-defined SVG constants, never user data - autoescape-safe #}
{% set icon = {
	brand:     '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6z"/><path d="M9 12l2 2 4-4"/></svg>',
	dashboard: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>',
	users:     '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M20 20a6 6 0 0 0-3-5"/></svg>',
	rbac:      '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6z"/><path d="M9 12l2 2 4-4"/></svg>',
	audit:     '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h6"/></svg>',
	settings:  '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>',
	sun:       '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4"/></svg>',
	moon:      '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 14a8 8 0 0 1-10-10 8 8 0 1 0 10 10z"/></svg>'
} %}
<div class="min-h-screen grid grid-cols-[220px_1fr]">

	<aside class="bg-surface-2 border-r border-line flex flex-col">
		<a href="{{ url('/backoffice') }}" class="flex items-center gap-2 px-4 h-14 border-b border-line">
			<span class="w-7 h-7 rounded-lg bg-accent text-accent-fg grid place-items-center">{{ icon.brand|raw }}</span>
			<span class="font-medium text-sm">{{ t('backoffice.brand') }}</span>
		</a>
		<nav class="p-3 flex flex-col gap-1">
			{% for item in nav %}
				<a href="{{ item.href }}"
					class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm {{ item.key == active ? 'bg-accent-bg text-accent-text font-medium' : 'text-fg-secondary hover:bg-surface-1' }}">
					<span class="shrink-0">{{ icon[item.key]|raw }}</span>{{ item.label }}
				</a>
			{% endfor %}
		</nav>
	</aside>

	<div class="flex flex-col min-w-0">
		<header class="h-14 flex items-center justify-between px-5 border-b border-line bg-surface-2">
			<span class="text-sm text-fg-muted">{{ t('backoffice.search') }}</span>
			<div class="flex items-center gap-3">
			 {# language switcher: same page, other locale #}
				<div class="flex items-center gap-1">
					{% for loc in locales %}
						<a href="{{ to_locale(loc, current_path) }}"
							class="px-2 py-1 rounded text-xs {{ loc == current_locale ? 'bg-accent-bg text-accent-text font-medium' : 'text-fg-secondary hover:bg-surface-1'}}">
							{{ loc|upper }}
						</a>
					{% endfor %}
				</div>
				{# no-JS: this button is inert, page still follows the OS theme #}
				<button type="button" data-theme-toggle aria-label="toggle_themes"
					class="w-8 h-8 grid place-items-center rounded-lg text-fg-secondary hover:bg-surface-1">
					<span class="icon-when-light">{{ icon.sun|raw }}</span>
					<span class="icon-when-dark">{{ icon.moon|raw }}</span>
				</button>
				<div class="flex items-center gap-2">
					<span class="w-8 h-8 rounded-full bg-accent-bg text-accent-text grid place-items-center text-xs font-medium">{{ user.name|slice(0, 2)|upper }}</span>
					<span class="text-sm">{{ user.name }}</span>
				</div>
				<form method="post" action="{{ url('/bakcoffice/logout') }}">
					<input type="hidden" name="_csrf" value="{{ csrf_token }}">
					<button type="submit" class="text-sm text-danger-text">{{ t('backoffice.logout') }}</button>
				</form>
			</div>
		</header>
		<main class="p-6">
			{% block main %}{% endblock %}
		</main>
	</div>
</div>
{% endblock %}