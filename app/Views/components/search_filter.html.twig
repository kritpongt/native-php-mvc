{# components/search_filter.html.twig #}
<div class="p-3 bg-surface-2 border border-line rounded-xl">
	<form id="search-filter-form" method="post"
		action="{{ action|default(url('/backoffice/users')) }}"
		hx-post="{{ action|default(url('/backoffice/users')) }}"
		hx-target="#data-table-container"
		hx-select="#data-table-container"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-trigger="submit, change from:select"
		class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full">
		
		{# Search Input Wrapper #}
		<div class="relative w-full sm:w-80">
			<input type="text" 
				name="q" 
				value="{{ search|default('') }}" 
				placeholder="{{ placeholder|default(t('backoffice.search')) }}" 
				class="w-full pl-9 pr-3 py-1.5 text-sm bg-surface-0 border border-line rounded-lg text-fg placeholder:text-fg-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
			<svg class="w-4 h-4 absolute left-3 top-2.5 text-fg-secondary pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="11" cy="11" r="8"/>
				<path d="m21 21-4.3-4.3"/>
			</svg>
		</div>

		{# Filters Dropdown #}
		{% if filters is defined and filters is not empty %}
			<div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full sm:w-auto justify-start sm:justify-end">
				{% for filter in filters %}
					<select name="{{ filter.name }}" 
						class="w-full sm:w-auto px-3 py-1.5 text-sm bg-surface-0 border border-line rounded-lg text-fg focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all cursor-pointer">
						<option value="">{{ filter.placeholder }}</option>
						{% for option in filter.options %}
							<option value="{{ option.value }}" {% if filter.selected is defined and filter.selected == option.value %}selected{% endif %}>
								{{ option.label }}
							</option>
						{% endfor %}
					</select>
				{% endfor %}
			</div>
		{% endif %}
	</form>
</div>
