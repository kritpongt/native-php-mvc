{
  "name": "kritpongt/native-php-mvc",
  "require": {
    "twig/twig": "^3.28",
    "spatie/browsershot": "^5.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "core/",
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration"
  }
}
