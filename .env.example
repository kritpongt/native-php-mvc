APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok

# mysql or pgsql - Core\Database reads this (step 6)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=native_mvc
DB_USER=root
DB_PASS=

SESSION_NAME=app_session
# dev on http -> false | production https -> true (the default)
SESSION_SECURE=false
SESSION_LIFETIME=0